{
  // ===== FILE VIEW & LANGUAGE SETTINGS =====
  "files.exclude": {
    "**/.git": true,
    "**/.gitignore": true
  },
  "files.associations": {
    "*.ps1": "powershell"
  },
  "explorer.sortOrder": "type",

  // ===== TERMINAL & ENVIRONMENT =====
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",

  // ===== EDITOR BEHAVIOR =====
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ===== POWERSHELL CODE STYLE =====
  "powershell.codeFormatting.preset": "Stroustrup",
  "powershell.codeFormatting.useCorrectCasing": true,

  // ===== PYTHON VENV =====
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

  // ===== GIT AUTO-FETCH SETTINGS =====
  "git.autofetch": true,
  "git.autofetchPeriod": 1800, // every 30 minutes
  "git.pruneOnFetch": true,
  "git.fetchOnPull": true,

  // ===== COMMAND RUNNER / ACTION BUTTONS =====
  "actionButtons": {
    "defaultColor": "#cccccc",
    "commands": [
      {
        "name": "🔁 Rebuild",
        "command": "workbench.action.tasks.runTask",
        "args": ["Rebuild Data JSONs"],
        "color": "#8be9fd",
        "tooltip": "Run Rebuild Data JSONs"
      },
      {
        "name": "📝 Rebuild+Commit",
        "command": "workbench.action.tasks.runTask",
        "args": ["Rebuild Data + Commit (No Push)"],
        "color": "#50fa7b",
        "tooltip": "Rebuild and commit locally (no push)"
      },
      {
        "name": "✅ Rebuild+Push",
        "command": "workbench.action.tasks.runTask",
        "args": ["Rebuild Data + Commit & Push"],
        "color": "#bd93f9",
        "tooltip": "Rebuild, commit, and push (safe branch only)"
      },
      {
        "name": "🌿 New Branch",
        "command": "workbench.action.tasks.runTask",
        "args": ["Safe: New Feature Branch"],
        "color": "#f1fa8c",
        "tooltip": "Create & push a safe feature branch"
      }
    ]
  }
}
